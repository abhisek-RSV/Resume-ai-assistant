# ---- Server ----
PORT=4000
# Comma-separated list of allowed origins, e.g. https://your-portfolio.com
FRONTEND_ORIGIN=*
LOG_LEVEL=INFO

# ---- Chat LLM: Ollama Cloud ----
# Create a key at https://ollama.com/settings/keys
OLLAMA_CHAT_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=gpt-oss:120b

# ---- Embeddings: local Ollama ----
# Pull once with: ollama pull qwen3-embedding:0.6b
OLLAMA_EMBED_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ---- Retrieval ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MAX_DISTANCE=0.75
